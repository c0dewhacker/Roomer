# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate both with: openssl rand -hex 32  (outputs 64 hex chars)
ROOMER_SESSION_SECRET=replace-with-64-hex-chars
ROOMER_ENCRYPTION_KEY=replace-with-64-hex-chars

# ── Application ───────────────────────────────────────────────────────────────
# Public URL of the web app — sets both ROOMER_CORS_ORIGIN and ROOMER_APP_URL
# on the API container.
APP_ORIGIN=http://localhost

# Host port for the web (nginx) container. Change if 8999 conflicts.
WEB_PORT=8999

# ── Cookie / security ─────────────────────────────────────────────────────────
# Set to true in any HTTPS environment.
ROOMER_COOKIE_SECURE=true

# ── Database ──────────────────────────────────────────────────────────────────
# Compose constructs ROOMER_DATABASE_URL from these — override if needed.
# POSTGRES_USER=roomer
# POSTGRES_PASSWORD=roomer
# POSTGRES_DB=roomer

# ── Email ─────────────────────────────────────────────────────────────────────
# ROOMER_EMAIL_FROM=noreply@roomer.local

# ── Seed (first-run only) ─────────────────────────────────────────────────────
# ROOMER_SEED_ADMIN_EMAIL=admin@roomer.local
# ROOMER_SEED_ADMIN_PASSWORD=
# ROOMER_SEED_DEMO_DATA=false
# ROOMER_SEED_USER_PASSWORD=
