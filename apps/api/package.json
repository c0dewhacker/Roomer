{
  "name": "@roomer/api",
  "version": "1.4.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "lint": "eslint src",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/session": "^11.1.4",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@roomer/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dxf-parser": "^1.1.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "jsonwebtoken": "^9.0.3",
    "ldapjs": "^3.0.7",
    "nodemailer": "^10.1.1",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "prisma": "^7.10.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "undici": "^8.12.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ldapjs": "^3.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
